# Copie para .env (ou exporte no shell) e ajuste. Nenhuma variável é obrigatória em desenvolvimento.

# desenvolvimento | producao. Em producao, SECRET_KEY passa a ser obrigatória.
APP_ENV=desenvolvimento
# Sem valor, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Lista separada por vírgula. "*" mantém o comportamento original (qualquer origem).
CORS_ORIGINS=*
# Token exigido no header X-Admin-Token por POST /admin/reset-db. Vazio desliga a rota (403).
ADMIN_TOKEN=
