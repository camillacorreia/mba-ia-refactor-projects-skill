# Copie para .env (ou exporte no shell). Nenhuma variável é obrigatória em desenvolvimento.
APP_ENV=desenvolvimento
DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Origens separadas por vírgula; "*" mantém o comportamento original (qualquer origem)
CORS_ORIGINS=*
# Sem valor, uma chave aleatória é gerada a cada boot e os tokens de login expiram no restart
SECRET_KEY=
# Sem valor, as rotas administrativas só aceitam Bearer de usuário admin
ADMIN_TOKEN=
TOKEN_MAX_AGE_SECONDS=3600
