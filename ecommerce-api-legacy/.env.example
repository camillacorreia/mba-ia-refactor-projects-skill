# Porta HTTP (default 3000)
PORT=3000
# Caminho do SQLite. Default ":memory:" (dados somem a cada boot e o seed roda de novo)
DB_PATH=:memory:
# Chave do gateway de pagamento. Vazio = gateway simulado (aprova cartões que começam com 4)
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas. Vazio = rotas admin respondem 403
ADMIN_TOKEN=
# debug | info | warn | error | silent
LOG_LEVEL=info
