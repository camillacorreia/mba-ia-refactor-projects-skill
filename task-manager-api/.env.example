# Copie para .env e ajuste. Nenhuma variável é obrigatória em desenvolvimento.

# development | production. Em production, SECRET_KEY passa a ser obrigatória.
ENV=development
# Sem valor, uma chave aleatória é gerada a cada boot (sessões não sobrevivem a restart).
SECRET_KEY=
DEBUG=false
# Use 0.0.0.0 para aceitar conexões de fora da máquina (o padrão anterior do projeto).
HOST=127.0.0.1
PORT=5000
# Caminho relativo de SQLite é resolvido dentro de instance/.
DATABASE_URL=sqlite:///tasks.db
# Lista separada por vírgula. "*" libera qualquer origem (comportamento original).
CORS_ORIGINS=*
LOG_LEVEL=INFO
