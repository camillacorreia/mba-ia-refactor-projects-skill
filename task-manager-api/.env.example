# Ambiente: "production" exige SECRET_KEY definida
ENV=development
# Chave para assinar tokens de login (gerada aleatoriamente no boot se vazia)
SECRET_KEY=
# Token administrativo (header X-Admin-Token). Vazio = só Bearer token de usuário admin
ADMIN_TOKEN=
# Validade do token de login, em segundos
TOKEN_MAX_AGE_SECONDS=28800
DEBUG=false
HOST=127.0.0.1
PORT=5000
# Relativo a instance/ quando sqlite:///<arquivo>
DATABASE_URL=sqlite:///tasks.db
# "*" ou lista separada por vírgula
CORS_ORIGINS=*
# SMTP para notificação de task atribuída (vazio = desabilitado, só registra no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
